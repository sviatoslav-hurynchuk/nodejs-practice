{
  "compilerOptions": {
    /* Основні налаштування */
    "target": "es2016",                                  /* У яку версію JS компілювати (сумісно з усіма Node.js) */
    "module": "commonjs",                                /* Стандартний тип модулів для Node.js (require/module.exports) */
    "moduleResolution": "node",

    /* Шляхи до файлів (найважливіше!) */
    "rootDir": "./src",                                  /* Де лежать твої .ts файли */
    "outDir": "./dist",                                  /* Куди класти готові .js файли */

    /* Суворість та перевірки */
    "strict": true,                                      /* Вмикає всі суворі перевірки типів */
    "esModuleInterop": true,                             /* Дозволяє зручно імпортувати бібліотеки */
    "skipLibCheck": true,                                /* Пришвидшує компіляцію, пропускаючи перевірку ліб */
    "forceConsistentCasingInFileNames": true,            /* Забороняє плутанину з регістром у назвах файлів */

    /* Налаштування для відлагодження */
    "sourceMap": true                                    /* Створює .map файли, щоб бачити TS код при дебазі */
  },
  "include": ["src/**/*"],                               /* Вказуємо компілятору, що компілювати треба все в папці src */
  "exclude": ["node_modules", "dist"]                    /* Що ігнорувати */
}